# Proxy reverso com HTTPS automático (Let's Encrypt).
# SITE_HOST = <ip-com-hifens>.sslip.io, gravado no .env pelo deploy (sslip.io resolve para o IP).
# Caddy roda como usuário não-root (uid 10002) e sem capabilities, então escuta em portas altas;
# o Docker publica 80->8080 e 443->8443. Este arquivo é embutido na imagem (proxy/Dockerfile).
{
	http_port 8080
	https_port 8443
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_HOST} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000

	log {
		output stdout
		format json
	}
}
